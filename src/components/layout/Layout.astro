---
import '../../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Investigación Científica - Universidad Nacional del Santa" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:wght@300;400;700;900&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-background text-surface font-sans antialiased min-h-screen flex flex-col">
		<!-- Header -->
		<header class="border-b border-slate-200 bg-white sticky top-0 z-10 shadow-sm">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
				<a href="/" class="flex items-center gap-3 group">
					<img src="/logo.png" alt="Logo UNS" class="h-12 w-auto object-contain" />
					<div class="flex flex-col">
						<span class="font-serif font-bold text-lg text-surface tracking-tight group-hover:text-uns transition-colors leading-tight">Universidad Nacional<br />del Santa</span>
						<span class="text-xs font-medium tracking-wider text-uns-light uppercase">Vicerrectorado de Investigación</span>
					</div>
				</a>
				<nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-surface-light">
					<a href="/" class="hover:text-uns transition-colors py-2 border-b-2 border-transparent hover:border-uns">Inicio</a>
					<a href="/lineas" class="hover:text-uns transition-colors py-2 border-b-2 border-transparent hover:border-uns">Líneas</a>
					<a href="/proyectos" class="hover:text-uns transition-colors py-2 border-b-2 border-transparent hover:border-uns">Proyectos</a>
					<a href="/investigadores" class="hover:text-uns transition-colors py-2 border-b-2 border-transparent hover:border-uns">Investigadores</a>
				</nav>
			</div>
		</header>

		<!-- Main Content -->
		<main class="flex-grow">
			<slot />
		</main>

		<!-- Footer Placeholder -->
		<footer class="bg-surface text-white py-12 mt-16">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<p class="font-serif text-lg mb-2">Universidad Nacional del Santa</p>
				<p class="text-sm text-slate-400">Vicerrectorado de Investigación</p>
			</div>
		</footer>
	</body>
</html>
