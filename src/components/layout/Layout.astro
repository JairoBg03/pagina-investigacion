---
import '../../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Investigación Científica - Universidad Nacional del Santa" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:wght@300;400;700;900&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-background text-surface font-sans antialiased min-h-screen flex flex-col">
		<!-- Header Placeholder -->
		<header class="border-b border-slate-200 bg-white sticky top-0 z-10">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
				<div class="flex items-center gap-2">
					<div class="w-8 h-8 bg-uns rounded-md flex items-center justify-center text-white font-bold font-serif">U</div>
					<span class="font-serif font-bold text-lg text-surface tracking-tight">Investigación <span class="text-uns">UNS</span></span>
				</div>
				<nav class="hidden md:flex items-center gap-6 text-sm font-medium text-surface-light">
					<a href="#" class="hover:text-uns transition-colors">Inicio</a>
					<a href="#" class="hover:text-uns transition-colors">Papers</a>
					<a href="#" class="hover:text-uns transition-colors">Investigadores</a>
					<a href="#" class="hover:text-uns transition-colors">Laboratorios</a>
				</nav>
			</div>
		</header>

		<!-- Main Content -->
		<main class="flex-grow">
			<slot />
		</main>

		<!-- Footer Placeholder -->
		<footer class="bg-surface text-white py-12 mt-16">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<p class="font-serif text-lg mb-2">Universidad Nacional del Santa</p>
				<p class="text-sm text-slate-400">Vicerrectorado de Investigación</p>
			</div>
		</footer>
	</body>
</html>
