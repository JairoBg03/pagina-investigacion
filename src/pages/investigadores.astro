---
import Layout from '../components/layout/Layout.astro';
---

<Layout title="Nuestros Investigadores - UNS">
	<div class="bg-background-alt py-16 border-b border-slate-200">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<span class="text-accent font-semibold tracking-wider text-sm uppercase mb-4 block">Talento Científico</span>
			<h1 class="text-4xl md:text-5xl font-serif font-bold text-surface mb-6 leading-tight">
				Nuestros <span class="text-uns">Investigadores</span>
			</h1>
			<p class="text-lg text-surface-light max-w-2xl mx-auto">
				Conoce a los profesionales que lideran la creación de conocimiento e innovación tecnológica en nuestra casa superior de estudios.
			</p>
		</div>
	</div>

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
		<!-- Filtros (simulados) -->
		<div class="flex flex-wrap items-center justify-center gap-4 mb-12">
			<button class="bg-uns text-white px-5 py-2 rounded-full text-sm font-medium shadow-sm">Todos</button>
			<button class="bg-white text-surface-light border border-slate-200 px-5 py-2 rounded-full text-sm font-medium hover:bg-slate-50 transition-colors">Ciencias</button>
			<button class="bg-white text-surface-light border border-slate-200 px-5 py-2 rounded-full text-sm font-medium hover:bg-slate-50 transition-colors">Ingeniería</button>
			<button class="bg-white text-surface-light border border-slate-200 px-5 py-2 rounded-full text-sm font-medium hover:bg-slate-50 transition-colors">Salud</button>
			<button class="bg-white text-surface-light border border-slate-200 px-5 py-2 rounded-full text-sm font-medium hover:bg-slate-50 transition-colors">Humanidades</button>
		</div>

		<!-- Grid de Investigadores -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
			<!-- Investigador 1 -->
			<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden text-center group hover:shadow-md transition-shadow">
				<div class="pt-8 pb-4">
					<div class="w-32 h-32 mx-auto rounded-full bg-slate-200 mb-4 border-4 border-white shadow-md relative">
						<!-- Placeholder image -->
						<div class="absolute inset-0 flex items-center justify-center text-slate-400">
							<svg class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
							</svg>
						</div>
					</div>
					<h3 class="text-xl font-serif font-bold text-surface group-hover:text-uns transition-colors">Dr. Juan Pérez Díaz</h3>
					<p class="text-sm font-medium text-accent mt-1">Biotecnología</p>
					<p class="text-xs text-surface-light mt-2 px-6">Investigador RENACYT Nivel II. Especialista en biotecnología de algas marinas.</p>
				</div>
				<div class="bg-slate-50 py-3 border-t border-slate-100 flex justify-center gap-4">
					<a href="#" class="text-surface-light hover:text-uns transition-colors">
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
					</a>
					<a href="#" class="text-surface-light hover:text-uns transition-colors">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
					</a>
				</div>
			</div>

			<!-- Investigador 2 -->
			<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden text-center group hover:shadow-md transition-shadow">
				<div class="pt-8 pb-4">
					<div class="w-32 h-32 mx-auto rounded-full bg-slate-200 mb-4 border-4 border-white shadow-md relative">
						<div class="absolute inset-0 flex items-center justify-center text-slate-400">
							<svg class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
							</svg>
						</div>
					</div>
					<h3 class="text-xl font-serif font-bold text-surface group-hover:text-uns transition-colors">Dra. María Gonzales</h3>
					<p class="text-sm font-medium text-accent mt-1">Ingeniería en Energía</p>
					<p class="text-xs text-surface-light mt-2 px-6">Expertise en modelado predictivo, redes eléctricas e inteligencia artificial.</p>
				</div>
				<div class="bg-slate-50 py-3 border-t border-slate-100 flex justify-center gap-4">
					<a href="#" class="text-surface-light hover:text-uns transition-colors">
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
					</a>
					<a href="#" class="text-surface-light hover:text-uns transition-colors">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
					</a>
				</div>
			</div>

			<!-- Investigador 3 -->
			<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden text-center group hover:shadow-md transition-shadow">
				<div class="pt-8 pb-4">
					<div class="w-32 h-32 mx-auto rounded-full bg-slate-200 mb-4 border-4 border-white shadow-md relative">
						<div class="absolute inset-0 flex items-center justify-center text-slate-400">
							<svg class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
							</svg>
						</div>
					</div>
					<h3 class="text-xl font-serif font-bold text-surface group-hover:text-uns transition-colors">MSc. Carlos Vílchez</h3>
					<p class="text-sm font-medium text-accent mt-1">Salud Pública</p>
					<p class="text-xs text-surface-light mt-2 px-6">Investigador de campo en el impacto de calidad de agua y metales pesados.</p>
				</div>
				<div class="bg-slate-50 py-3 border-t border-slate-100 flex justify-center gap-4">
					<a href="#" class="text-surface-light hover:text-uns transition-colors">
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
					</a>
					<a href="#" class="text-surface-light hover:text-uns transition-colors">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
					</a>
				</div>
			</div>

			<!-- Investigador 4 -->
			<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden text-center group hover:shadow-md transition-shadow">
				<div class="pt-8 pb-4">
					<div class="w-32 h-32 mx-auto rounded-full bg-slate-200 mb-4 border-4 border-white shadow-md relative">
						<div class="absolute inset-0 flex items-center justify-center text-slate-400">
							<svg class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
							</svg>
						</div>
					</div>
					<h3 class="text-xl font-serif font-bold text-surface group-hover:text-uns transition-colors">Dra. Luisa Mera</h3>
					<p class="text-sm font-medium text-accent mt-1">Física Aplicada</p>
					<p class="text-xs text-surface-light mt-2 px-6">Directora del laboratorio de instrumentación y sensores remotos (IoT).</p>
				</div>
				<div class="bg-slate-50 py-3 border-t border-slate-100 flex justify-center gap-4">
					<a href="#" class="text-surface-light hover:text-uns transition-colors">
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
					</a>
					<a href="#" class="text-surface-light hover:text-uns transition-colors">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
					</a>
				</div>
			</div>
		</div>

		<!-- Llamado a la acción -->
		<div class="mt-16 bg-surface rounded-2xl p-8 md:p-12 text-center text-white relative overflow-hidden">
			<div class="absolute inset-0 bg-uns opacity-10"></div>
			<div class="relative z-10 max-w-3xl mx-auto">
				<h2 class="text-3xl font-serif font-bold mb-4">¿Deseas colaborar con nuestros investigadores?</h2>
				<p class="text-slate-300 mb-8">El Vicerrectorado de Investigación fomenta las alianzas estratégicas con universidades internacionales y la empresa privada.</p>
				<button class="bg-uns hover:bg-uns-light text-white px-8 py-3 rounded-md font-medium transition-colors shadow-lg shadow-uns/30">
					Contactar a VRI
				</button>
			</div>
		</div>
	</div>
</Layout>
